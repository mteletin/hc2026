<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:runtime="using:Hc2000.App.Runtime"
        xmlns:local="using:Hc2000.App"
        xmlns:media="using:Hc2000.App.Media"
        xmlns:snapshots="using:Hc2000.App.Snapshots"
        x:Class="Hc2000.App.MainWindow"
        Title="HC2000">
  <Window.Styles>
    <!-- Machine text keys stay unhandled for native TextInput. Toolbar buttons are
         pointer actions: Space must not click the last one. Draft fields opt in. -->
    <Style Selector="Button">
      <Setter Property="Focusable" Value="False"/>
    </Style>
    <Style Selector="Border.section">
      <Setter Property="Padding" Value="8"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}"/>
    </Style>
    <Style Selector="TextBlock.sectionTitle">
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
  </Window.Styles>
  <DockPanel>
    <!-- The screen owns the client slot left after the chrome: a finite, non-scrolling
         rectangle. The zoom formula gives it an integer scale at most the requested zoom
         and at most what fits this slot; everything above it scrolls. -->
    <Grid Name="ScreenSlot" DockPanel.Dock="Bottom" HorizontalAlignment="Stretch" IsVisible="False">
      <runtime:AspectRatioViewport Name="ScreenViewport" FitToWindow="False">
        <runtime:AspectRatioViewport.Surface>
          <runtime:VideoSurface Name="Screen" AutomationProperties.Name="HC2000 screen" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
        </runtime:AspectRatioViewport.Surface>
      </runtime:AspectRatioViewport>
      <local:CellBoundaryOverlay Name="CellBoundaries" IsVisible="False" IsHitTestVisible="False"/>
    </Grid>

    <!-- Top Shell Bar / Unified Tab Strip -->
    <Border Classes="shellHeader" DockPanel.Dock="Top">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <TextBlock Classes="appTitle" Text="HC2000" VerticalAlignment="Center"/>
          <TextBlock Classes="caption" Text="·" VerticalAlignment="Center" Margin="2,0"/>
          <TextBlock Name="MachineWorkspaceHeading" Classes="sectionTitle" Text="Machines" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Machine Tabs in the primary strip -->
        <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="12,0">
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <StackPanel Name="MachineTabs" Orientation="Horizontal" Spacing="6" IsVisible="False"/>
            <Button Name="NewMachine" Classes="toolbarAction" Content="New machine" AutomationProperties.Name="Configure a new machine" ToolTip.Tip="Configure a new machine (Ctrl+Shift+N)"/>
          </StackPanel>
        </ScrollViewer>

        <!-- Right action strip -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <Button Name="MachineReset" Classes="toolbarAction" Content="Reset selected machine" IsEnabled="False" ToolTip.Tip="Reset selected machine (Ctrl+Shift+R)"/>
          <Button Name="OpenSettingsButton" Classes="toolbarAction" Content="Settings…" Click="OpenSettings" ToolTip.Tip="Application preferences (Ctrl+Shift+,)"/>
          <Button Name="OpenDebuggerButton" Classes="toolbarAction" Content="Debugger…" Click="OpenDebugger" ToolTip.Tip="Open debugger (Ctrl+Shift+D)"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Scrollable workspace body -->
    <ScrollViewer Name="ShellScroll" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="12,8" Spacing="8">
        <TextBlock Name="EmptyWorkspace" Classes="caption" Text="No machine started. Configure the first machine below." TextWrapping="Wrap"/>
        <StackPanel Name="SelectedMachineHeading" Spacing="4" IsVisible="False">
          <TextBlock Classes="caption" Text="Selected machine:"/>
          <TextBlock Name="SelectedMachineName" Classes="sectionTitle" Text="No machine selected" TextWrapping="Wrap"/>
          <TextBlock Name="EffectiveHardware" Classes="caption" TextWrapping="Wrap"/>
          <TextBlock Classes="caption" Text="Reset, mounted media, snapshots and guest input affect only this selected machine." TextWrapping="Wrap"/>
        </StackPanel>
        <TextBlock Name="RuntimeStatus" Classes="caption" Text="Draft: configure, then Start machine. No guest executing." TextWrapping="Wrap"/>
        <Border Name="ConfigurationCard" Classes="section">
          <ContentControl Name="PrestartConfiguration"/>
        </Border>
        <StackPanel Name="RunningWorkspace" Spacing="8" IsVisible="False">
          <StackPanel Name="Z80DemoControls" IsVisible="False" Orientation="Horizontal" Spacing="8">
            <Button Name="Z80DemoRerun" Classes="primaryAction" AutomationProperties.Name="Reset / Run again" Content="Reset / Run again"/>
          </StackPanel>
          <CheckBox Name="CellOverlayToggle" Content="Show 8×8 cell boundaries (inspection overlay)"/>
          <Expander Header="Reconfigure and reset · selected machine">
            <ContentControl Name="ReconfigureConfiguration" Margin="0,4,0,0"/>
          </Expander>
          <Expander Header="Media and disks · selected machine">
            <media:MediaPanel Name="MediaControls" Margin="0,4,0,0"/>
          </Expander>
          <Expander Header="Media homes · scanned images">
            <media:MediaHomeListPanel Name="MediaHomeList" Margin="0,4,0,0"/>
          </Expander>
          <media:ProfileRomPanel Name="ProfileRomControls" IsVisible="False" IsEnabled="False"/>
          <Expander Header="Snapshots · selected machine">
            <snapshots:HcsPanel Name="SnapshotControls" Margin="0,4,0,0"/>
          </Expander>
          <Border Classes="section">
            <StackPanel Spacing="6">
              <TextBlock Classes="sectionTitle" Text="Keyboard and paste · selected machine"/>
              <TextBlock Classes="caption" Text="Keyboard mapping"/>
              <ComboBox x:Name="InputModeBox" AutomationProperties.Name="Keyboard mapping">
                <ComboBoxItem Content="Symbolic (host text)"/>
                <ComboBoxItem Content="Positional (physical keys)"/>
              </ComboBox>
              <TextBox x:Name="PasteTextBox" AutomationProperties.Name="Text to paste into the machine" PlaceholderText="Text to paste into the selected machine" AcceptsReturn="True" Height="70"/>
              <Button x:Name="PasteButton" Classes="toolbarAction" Content="Queue paste" Click="PasteInput"/>
              <TextBlock x:Name="InputNotice" Classes="caption" Text="Input queued only; the selected runtime consumes it. F2: Edit, F3: Graph, Alt: Symbol Shift (positional)." TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
